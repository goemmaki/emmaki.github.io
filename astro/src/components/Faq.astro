---
interface Item { question: string; answer: string }
interface Props { faqs: Item[]; bodyText: string; idPrefix?: string }
const { faqs, bodyText, idPrefix = 'faq' } = Astro.props;
---
<div class="mt-2" data-faq>
  {faqs.map(({ question, answer }, index) => <div class="border-b border-line">
    <h3><button id={`faq-trigger-${idPrefix}-${index}`} type="button" class="faq-trigger group flex w-full items-center justify-between gap-6 py-6 text-left font-heading text-lg font-normal leading-[1.4]" aria-expanded="false" data-faq-trigger>
      {question}<svg class="size-6 shrink-0" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      <svg class="size-6 shrink-0 hidden" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/></svg>
    </button></h3>
    <div id={`faq-answer-${idPrefix}-${index}`} aria-labelledby={`faq-trigger-${idPrefix}-${index}`} role="region" class="faq-panel" hidden="until-found" data-faq-panel><p class={`pt-4 pb-6 ${bodyText}`}>{answer}</p></div>
  </div>)}
</div>
<script>
for (const root of document.querySelectorAll<HTMLElement>('[data-faq]')) {
  const triggers = [...root.querySelectorAll<HTMLButtonElement>('[data-faq-trigger]')];
  const panelFor = (button: HTMLButtonElement) => button.closest('h3')?.nextElementSibling as HTMLElement;
  const setOpen = (button: HTMLButtonElement, open: boolean) => {
    const panel = panelFor(button);
    button.setAttribute('aria-expanded', String(open));
    if (open) button.dataset.panelOpen = ''; else delete button.dataset.panelOpen;
    button.querySelectorAll('svg')[0].classList.toggle('hidden', open);
    button.querySelectorAll('svg')[1].classList.toggle('hidden', !open);
    if (open) { panel.removeAttribute('hidden'); panel.dataset.open = ''; panel.style.height = '0px'; requestAnimationFrame(() => { panel.style.height = `${panel.scrollHeight}px`; }); }
    else { panel.style.height = `${panel.scrollHeight}px`; requestAnimationFrame(() => { panel.style.height = '0px'; }); delete panel.dataset.open; }
  };
  for (const button of triggers) {
    const panel = panelFor(button);
    button.addEventListener('click', () => setOpen(button, button.getAttribute('aria-expanded') !== 'true'));
    panel.addEventListener('transitionend', event => { if (event.propertyName !== 'height') return; if (button.getAttribute('aria-expanded') === 'true') panel.style.height = `${panel.scrollHeight}px`; else { panel.setAttribute('hidden', 'until-found'); panel.style.removeProperty('height'); } });
    panel.addEventListener('beforematch', () => setOpen(button, true));

  }
}
</script>
