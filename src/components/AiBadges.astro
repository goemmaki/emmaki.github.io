---
import { AI_LOGO_PATHS } from '@/components/blog/ai-logos';
interface Props { aiQuestion?: string }
const { aiQuestion } = Astro.props;
---
<div data-ai-badges data-ai-question={aiQuestion ?? ''}>
  <p class="type-meta uppercase text-fg-2">Ask AI</p>
  <ul class="mt-3 flex gap-2">
    {(['ChatGPT', 'Claude', 'Google AI', 'Grok', 'Perplexity'] as const).map(name => <li><a href="#" target="_blank" rel="noopener noreferrer" aria-label={`Ask ${name}`} class="flex size-11 items-center justify-center rounded-sm border border-line text-fg-2 transition-colors hover:bg-surface hover:text-fg-max md:size-9" data-ai-badge={name}><svg viewBox="0 0 24 24" class="size-4 shrink-0" aria-hidden="true" fill="currentColor" fill-rule={name === 'Grok' ? 'evenodd' : undefined}><path d={AI_LOGO_PATHS[name]}/></svg></a></li>)}
  </ul>
</div>
<script is:inline define:vars={{ question: aiQuestion ?? '' }}>
  (function(){var root=document.currentScript&&document.currentScript.previousElementSibling;if(!root)return;var url=location.href,prompt=question?`Read ${url}, then answer: ${question}`:`Read from ${url} so I can ask questions about it`,q=encodeURIComponent(prompt);root.querySelectorAll('[data-ai-badge]').forEach(function(link){var name=link.getAttribute('data-ai-badge');link.href=name==='ChatGPT'?'https://chatgpt.com/?q='+q:name==='Claude'?'https://claude.ai/new?q='+q:name==='Google AI'?'https://www.google.com/search?q='+q+'&udm=50':name==='Grok'?'https://grok.com/?q='+q:'https://www.perplexity.ai/search/?q='+q})})()
</script>
