---
import { Picture } from 'astro:assets';
import complicated from '../assets/approach/complicated.jpg';
import build from '../assets/approach/build.jpg';
import briefs from '../assets/approach/briefs.jpg';
import honest from '../assets/approach/honest.jpg';
import reliable from '../assets/approach/reliable.jpg';
import listen from '../assets/approach/listen.jpg';
import outcomes from '../assets/approach/outcomes.jpg';
import luddite from '../assets/approach/luddite.jpg';
interface Props { items: { title: string; content: string }[] }
const { items } = Astro.props;
const photos = [
  { src: complicated, alt: 'Stone channels and black irrigation hoses cross dry ground beneath olive trees on a mountain terrace.' },
  { src: build, alt: 'Sorted stones and a mason’s hammer sit beside a dry-stone wall being repaired.' },
  { src: briefs, alt: 'A weathered wooden direction post stands at a fork in a narrow mountain lane.' },
  { src: honest, alt: 'Two empty chairs face a small outdoor table on a quiet village lane.' },
  { src: reliable, alt: 'Fresh loaves cool on a wooden rack beside a village bakery’s wood-fired oven.' },
  { src: listen, alt: 'Painted beehives stand on a hillside among thyme and stone terraces.' },
  { src: outcomes, alt: 'Harvest nets beneath old olive trees hold olives and scattered leaves.' },
  { src: luddite, alt: 'Unfinished woven cloth rests on a wooden hand loom in a village house.' },
];
if (items.length !== photos.length) throw new Error('Each approach step needs its matching photo.');
---
<!-- Native scrolling, shared text/photo movement (owner, 2026-11-04). The default is a complete list. -->
<div class="story" data-approach-story style={`--story-count: ${items.length}`}>
  <div class="story-stage shell">
    <header>
      <p class="type-meta text-fg-2 uppercase">My approach</p>
      <h2 id="approach-heading" class="mt-6 max-w-[36ch] type-h2 text-fg-max">Copywriting is only part of my job.</h2>
    </header>
    <div class="story-progress" aria-hidden="true">{items.map((_, i) => <span data-story-dash data-active={i === 0 ? '' : undefined} />)}</div>
    <ol class="story-items" role="list">
      {items.map(({ title, content }, i) => <li class="story-item" data-story-item data-active={i === 0 ? '' : undefined} style={`--story-offset: ${i === 0 ? 0 : 1}`}>
        <div class="story-card">
          <div class="story-copy">
            <p class="story-number type-meta text-fg-2" aria-hidden="true">{String(i + 1).padStart(2, '0')} / {String(items.length).padStart(2, '0')}</p>
            <h3 class="type-h2 text-fg-max">{title}</h3>
            <p class="story-body type-lead text-fg-2">{content}</p>
          </div>
          <Picture src={photos[i].src} alt={photos[i].alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[320, 480, 640, 960]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 40vw, 80vw" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        </div>
      </li>)}
    </ol>
  </div>
</div>
<script is:inline>
  // Reserve the scroll track before first paint; no-JS and reduced motion keep the list.
  {
    const root = document.currentScript.previousElementSibling;
    if (matchMedia('(min-width: 1024px) and (min-height: 760px) and (prefers-reduced-motion: no-preference)').matches && 'onbeforematch' in document.documentElement) {
      root.dataset.storyEnhanced = '';
      root.querySelectorAll('[data-story-item]').forEach((item, i) => {
        if (i) { item.setAttribute('hidden', 'until-found'); item.setAttribute('aria-hidden', 'true'); }
      });
    }
  }
</script>
<script>
  import { initApproachStory } from './approach-story';
  document.querySelectorAll<HTMLElement>('[data-approach-story]').forEach(initApproachStory);
</script>
<style>
  .story { --story-duration: 650ms; --story-ease: cubic-bezier(.65, 0, .35, 1); }
  .story-progress { display: none; gap: var(--space-interface-8); margin-block: var(--space-interface-32); }
  .story-progress span { width: var(--space-interface-24); height: var(--shape-border-width); background: var(--color-fg-muted); }
  .story-progress [data-active] { background: var(--color-fg-max); }
  .story-items { margin-top: var(--space-editorial-52); display: grid; gap: var(--space-editorial-136); }
  .story-card { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); align-items: center; }
  .story-copy { grid-column: 1 / 7; }
  .story-number { margin-bottom: var(--space-interface-24); }
  .story-body { margin-top: var(--space-interface-24); max-width: 44ch; }
  .story-card :global(picture) { grid-column: 8 / 12; display: block; min-height: 0; }
  .story-card :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; border-radius: var(--shape-control-radius); }
  @media (max-width: 767px) {
    .story-card { display: flex; flex-direction: column-reverse; align-items: flex-start; gap: var(--space-interface-32); }
    .story-card :global(picture) { width: 80%; }
  }
  @media (min-width: 1024px) and (min-height: 760px) and (prefers-reduced-motion: no-preference) {
    .story[data-story-enhanced] { height: calc(100svh + var(--story-count) * 85svh); }
    [data-story-enhanced] .story-stage { position: sticky; top: 0; height: 100svh; padding-top: var(--space-editorial-84); padding-bottom: var(--space-interface-32); display: flex; flex-direction: column; will-change: transform; }
    [data-story-enhanced] .story-stage > header { position: relative; z-index: 1; }
    [data-story-enhanced] .story-progress { display: flex; }
    [data-story-enhanced] .story-items { position: relative; flex: 1; min-height: 0; margin: 0; display: block; overflow: clip; }
    [data-story-enhanced] .story-item { position: absolute; inset: 0; }
    [data-story-enhanced] .story-card { height: 100%; transform: translateY(calc(var(--story-offset) * 110%)); opacity: 0; }
    [data-story-enhanced] [data-active] .story-card { opacity: 1; }
    [data-story-enhanced][data-story-live] .story-card { transition: transform var(--story-duration) var(--story-ease), opacity var(--story-duration) var(--story-ease); }
    [data-story-enhanced] .story-copy { grid-column: 1 / 6; }
    [data-story-enhanced] .story-number { display: none; }
    [data-story-enhanced] .story-card :global(picture) { height: 100%; width: 100%; display: flex; align-items: center; justify-content: flex-start; }
    [data-story-enhanced] .story-card :global(img) { width: auto; height: 100%; max-width: 100%; object-fit: cover; }
  }
  @media (min-width: 1024px) and (min-height: 760px) and (max-height: 850px) and (prefers-reduced-motion: no-preference) {
    /* Keep the longest answer inside the stage on shorter laptops. */
    [data-story-enhanced] .story-copy h3 { font-size: var(--type-heading-h3-size); line-height: var(--type-heading-h3-leading); }
    [data-story-enhanced] .story-body { font-size: var(--type-body-default-size); line-height: var(--type-body-default-leading); }
  }
</style>
