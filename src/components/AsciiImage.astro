---
interface Props { src: string; width: number; height: number; cols?: number; class?: string }
const { src, width, height, cols = 150, class: className } = Astro.props;
---
<canvas data-ascii-image data-src={src} data-width={width} data-height={height} data-cols={cols} aria-hidden="true" class={className} style={`aspect-ratio:${width}/${height}`}></canvas>
<script>
const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5], EDGE = 0.45, CONTRAST = { dark: [0.12, 0.92], light: [0.2, 0.8] }, FPS = 12;
const lift = (c: number, tone: number) => Math.round(c * 0.9 + (220 - c * 0.9) * tone * 0.3);
for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-ascii-image]')) {
  const screen = canvas.getContext('2d'); if (!screen) continue;
  const src = canvas.dataset.src!, width = Number(canvas.dataset.width), height = Number(canvas.dataset.height), cols = Number(canvas.dataset.cols), rows = Math.round(cols * height / width);
  const art = document.createElement('canvas'), ctx = art.getContext('2d'); if (!ctx) continue;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)'); let still = reduce.matches, cells: Uint8ClampedArray | null = null;
  const image = new Image(); image.src = src;
  function sample() { const small = document.createElement('canvas'); small.width = cols; small.height = rows; const c = small.getContext('2d')!; c.imageSmoothingQuality = 'high'; c.drawImage(image, 0, 0, cols, rows); cells = c.getImageData(0, 0, cols, rows).data; }
  function show(judder: boolean) {
    const w = canvas.width, h = canvas.height; screen!.clearRect(0, 0, w, h);
    if (!judder) { screen!.globalAlpha = 1; screen!.drawImage(art, 0, 0); return; }
    screen!.globalAlpha = 0.92 + Math.random() * 0.08; const unit = Math.max(1, w / 250), shifts = new Float32Array(h);
    if (Math.random() < 0.3) for (let n = 1 + Math.floor(Math.random() * 3); n > 0; n--) { const top = Math.floor(Math.random() * h), tall = Math.floor(h * (0.08 + Math.random() * 0.17)), by = Math.round((Math.random() < 0.5 ? -1 : 1) * unit * (1 + Math.random() * 2)); shifts.fill(by, top, Math.min(h, top + tall)); }
    if (Math.random() < 0.05) { const top = Math.floor(Math.random() * h); shifts.fill(Math.round(unit * (6 + Math.random() * 6)), top, Math.min(h, top + Math.floor(h * (0.02 + Math.random() * 0.04)))); }
    for (let y = 0; y < h;) { let end = y + 1; while (end < h && shifts[end] === shifts[y]) end++; screen!.drawImage(art, 0, y, w, end - y, shifts[y], y, w, end - y); y = end; }
  }
  function draw() {
    if (!cells) return; const dpr = Math.min(devicePixelRatio, 2), box = canvas.getBoundingClientRect(); canvas.width = art.width = Math.round(box.width * dpr); canvas.height = art.height = Math.round(box.height * dpr); ctx!.setTransform(dpr, 0, 0, dpr, 0, 0); ctx!.clearRect(0, 0, box.width, box.height);
    const light = document.documentElement.dataset.theme === 'light', [black, white] = CONTRAST[light ? 'light' : 'dark'], cw = box.width / cols, ch = box.height / rows, mono = getComputedStyle(canvas).getPropertyValue('--font-mono') || 'monospace';
    ctx!.font = `${Math.round(ch * 1.05)}px ${mono}`; ctx!.textAlign = 'center'; ctx!.textBaseline = 'middle'; ctx!.lineCap = 'square'; ctx!.lineWidth = Math.max(1, cw * 0.18);
    const lum = (x: number, y: number) => { const i = (Math.min(rows - 1, Math.max(0, y)) * cols + Math.min(cols - 1, Math.max(0, x))) * 4; return ((0.2126 * cells![i] + 0.7152 * cells![i + 1] + 0.0722 * cells![i + 2]) / 255) * (cells![i + 3] / 255); };
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) { const i = (y * cols + x) * 4, alpha = cells[i + 3] / 255; if (alpha < 0.5) continue; const l = Math.min(1, Math.max(0, (lum(x, y) - black) / (white - black))), tone = light ? 1 - l : l; if (tone <= (BAYER[(y % 4) * 4 + x % 4] + 0.5) / 16) continue;
      const gx = lum(x + 1, y - 1) + 2 * lum(x + 1, y) + lum(x + 1, y + 1) - lum(x - 1, y - 1) - 2 * lum(x - 1, y) - lum(x - 1, y + 1), gy = lum(x - 1, y + 1) + 2 * lum(x, y + 1) + lum(x + 1, y + 1) - lum(x - 1, y - 1) - 2 * lum(x, y - 1) - lum(x + 1, y - 1), strength = Math.hypot(gx, gy) / 4;
      const colour = light ? `rgb(17 17 17 / ${0.55 + 0.45 * tone})` : `rgb(${lift(cells[i], tone)} ${lift(cells[i + 1], tone)} ${lift(cells[i + 2], tone)})`; ctx!.fillStyle = ctx!.strokeStyle = colour; const cx = x * cw + cw / 2, cy = y * ch + ch / 2;
      if (strength > EDGE) { const angle = ((Math.atan2(gy, gx) * 180) / Math.PI + 90 + 360) % 180; ctx!.fillText(['-', '\\', '|', '/'][Math.round(angle / 45) % 4], cx, cy); } else if (tone > 0.97) ctx!.fillText('+', cx, cy); else { const s = Math.max(1, cw * 0.7); ctx!.fillRect(cx - s / 2, cy - s / 2, s, s); }
    }
    ctx!.globalCompositeOperation = 'destination-out'; ctx!.fillStyle = 'rgb(0 0 0 / 0.35)'; for (let y = 0; y < box.height; y += 3) ctx!.fillRect(0, y, box.width, 1); ctx!.globalCompositeOperation = 'source-over'; show(false);
  }
  let frame = 0, then = 0, visible = false;
  function tick(now: number) { frame = requestAnimationFrame(tick); if (now - then < 1000 / FPS) return; then = now; show(true); }
  function play() { cancelAnimationFrame(frame); if (visible && !still && cells) frame = requestAnimationFrame(tick); else if (cells) show(false); }
  const seen = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; play(); }); seen.observe(canvas);
  const onMotion = () => { still = reduce.matches; play(); }; reduce.addEventListener('change', onMotion);
  image.decode().then(() => { sample(); draw(); play(); }).catch(error => console.error('ASCII image decode failed', { src, step: 'decode' }, error));
  const resize = new ResizeObserver(draw); resize.observe(canvas); const theme = new MutationObserver(draw); theme.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
}
</script>
