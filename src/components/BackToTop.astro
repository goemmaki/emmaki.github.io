---
import IconTip from './IconTip.astro';
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<a href="#content" aria-label="Back to top" class={`back-to-top icon-action relative ${className}`}>
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 12-4-4-4 4"></path><path d="M12 16V8"></path></svg>
  <IconTip>Back to top</IconTip>
</a>
<script>
  const triggers = document.querySelectorAll<HTMLAnchorElement>('.back-to-top');
  for (const trigger of triggers) {
    trigger.addEventListener('click', event => {
      event.preventDefault();
      window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      document.getElementById('content')?.focus({ preventScroll: true });
    });
  }
</script>
