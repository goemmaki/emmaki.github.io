---
// Caution tape between the client logos and the statement: the page turns from the hero's swagger to
// the measured voice of everything below it. Two crossed strips of flat yellow with hazard edges and
// warning signs between the phrases, crawling in opposite directions. Decorative (the next heading
// carries the meaning), so it is hidden from assistive tech.
const phrase = 'Fun’s over';
// Each half of the track must outrun the widest screen so the loop never shows a gap.
const copies = Array.from({ length: 18 });
---
<div class="tape" data-tape aria-hidden="true">
  {[true, false].map(back => (
    <div class:list={['tape-band', back && 'tape-band--back']}>
      <div class="tape-track">{[0, 1].map(() => <div class="tape-half">{copies.map(() => <><span class="tape-item">{phrase}</span><svg class="tape-sign" viewBox="0 0 24 22"><path fill-rule="evenodd" d="M12 .5 23.5 21.5H.5ZM10.7 7.5h2.6l-.45 7.6h-1.7ZM12 16.4a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 1 0 0-2.9Z" /></svg></>)}</div>)}</div>
    </div>
  ))}
</div>
<script>
  const tape = document.querySelector<HTMLElement>('[data-tape]');
  if (tape) {
    // A steady crawl speed, and halves that are a whole number of hazard stripes wide, so the moving
    // edges loop without a jump.
    const STRIPE = 16;
    const pace = () => {
      const halves = [...tape.querySelectorAll<HTMLElement>('.tape-half')];
      for (const half of halves) half.style.paddingInlineEnd = '';
      const width = halves[0].offsetWidth, pad = (STRIPE - (width % STRIPE)) % STRIPE;
      for (const half of halves) half.style.paddingInlineEnd = `${pad}px`;
      tape.style.setProperty('--tape-duration', `${(width + pad) / 40}s`);
    };
    document.fonts.ready.then(pace).catch(error => console.error('Tape font failed to load', error));
    const tracks = [...tape.querySelectorAll<HTMLElement>('.tape-track')];
    new IntersectionObserver(([entry]) => {
      for (const track of tracks) track.style.animationPlayState = entry.isIntersecting ? 'running' : 'paused';
    }).observe(tape);
  }
</script>
<style>
  /* Tape is a physical object: the same yellow and black in both themes. */
  .tape {
    --tape-yellow: var(--color-brand-yellow-splash); --tape-black: #000; --tape-edge: 6px;
    --tape-stripes: repeating-linear-gradient(-45deg, var(--tape-black) 0 5.657px, var(--tape-yellow) 5.657px 11.314px);
    position: relative; display: grid; margin-top: calc(3 * var(--space-interface-32)); padding-block: var(--space-interface-32); overflow-x: clip;
  }
  .tape-band { position: relative; grid-area: 1 / 1; width: 110vw; margin-left: -5vw; display: flex; height: clamp(2.75rem, 3.6vw, 3.5rem); background: var(--tape-yellow); color: var(--tape-black); overflow: hidden; rotate: -3deg; }
  /* The strip underneath is a shade darker and runs the other way. */
  .tape-band--back { rotate: 3deg; }
  .tape-band--back .tape-track { animation-direction: reverse; }
  .tape-track { display: flex; width: max-content; background-image: var(--tape-stripes), var(--tape-stripes); background-position: top left, bottom left; background-size: 16px var(--tape-edge), 16px var(--tape-edge); background-repeat: repeat-x, repeat-x; animation: tape-crawl var(--tape-duration, 60s) linear infinite; }
  .tape-band:not(.tape-band--back) { filter: drop-shadow(0 3px 2px rgb(0 0 0 / 0.45)) drop-shadow(0 10px 14px rgb(0 0 0 / 0.3)); }
  .tape-band--back { filter: brightness(0.72) saturate(0.9); }
  .tape-half { display: flex; align-items: center; }
  .tape-item { padding-inline-end: 1.1em; font-family: var(--font-heading); font-weight: 800; font-size: clamp(1rem, 1.45vw, 1.375rem); letter-spacing: 0.02em; text-transform: uppercase; white-space: nowrap; }
  /* A black warning sign between the phrases; the ! is cut out, so the tape's yellow shows through. */
  .tape-sign { flex: none; width: 1.35em; height: auto; margin-inline-end: 1.1em; font-size: clamp(1rem, 1.45vw, 1.375rem); fill: currentColor; translate: 0 -.05em; }
  @keyframes tape-crawl { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .tape-track { animation: none; } }
  /* Over a narrow screen ±3° barely diverges, so phones get a steeper cross. */
  @media (max-width: 599px) {
    .tape-band { rotate: -7deg; }
    .tape-band--back { rotate: 7deg; }
  }
</style>
