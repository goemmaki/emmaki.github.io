---
import { BRANDS, CLIENT_STRIP_ORDER } from '@/lib/content';
const clients = [...BRANDS].sort((a, b) => CLIENT_STRIP_ORDER.indexOf(a.name) - CLIENT_STRIP_ORDER.indexOf(b.name));
---
<div class="client-strip shell" data-client-strip>
  <ul class="sr-only">{clients.map((brand) => <li>{brand.name}</li>)}</ul>
  <ul class="client-slots" data-client-slots style="--cols:5" aria-hidden="true"></ul>
</div>
<script>
import { BRANDS, CLIENT_STRIP_ORDER } from '@/lib/content';
for (const strip of document.querySelectorAll<HTMLElement>('[data-client-strip]')) {
const list = strip.querySelector<HTMLElement>('[data-client-slots]');
if (list) {
  const clients = [...BRANDS].sort((a, b) => CLIENT_STRIP_ORDER.indexOf(a.name) - CLIENT_STRIP_ORDER.indexOf(b.name));
  let cols = 5, shown: number[] = [], queue: number[] = [], hovered = false, visible = false, timer = 0, preparing = false;
  const reels: HTMLElement[] = [];
  const makeLogo = (brand: typeof clients[number]) => {
    const logo = document.createElement('span'); logo.className = 'client-slot-logo';
    for (const [file, cls] of [[brand.logo.light, 'client-logo-on-light'], [brand.logo.dark, 'client-logo-on-dark']]) {
      const img = document.createElement('img'); img.src = `/clients/${file}`; img.alt = ''; img.className = cls;
      const copy = img.cloneNode(false) as HTMLImageElement; copy.classList.add('client-logo-color-copy'); copy.setAttribute('aria-hidden', 'true'); copy.dataset.colorCopy = '';
      logo.append(img, copy);
    }
    return logo;
  };
  const updateCols = () => {
    const next = matchMedia('(min-width: 64rem)').matches ? 5 : matchMedia('(min-width: 40rem)').matches ? 3 : 2;
    if (next === cols && reels.length) return;
    cols = next; shown = Array(cols).fill(0); queue = []; list.style.setProperty('--cols', String(cols)); list.replaceChildren(); reels.length = 0;
    for (let c = 0; c < cols; c++) {
      const li = document.createElement('li'); li.className = 'client-slot';
      const reel = document.createElement('div'); reel.className = 'client-slot-reel'; li.append(reel); list.append(li); reels.push(reel); render(c);
    }
  };
  const render = (c: number) => {
    const reel = reels[c]; if (!reel) return;
    const brands = clients.filter((_, i) => i % cols === c);
    reel.replaceChildren(makeLogo(brands[shown[c] % brands.length]), makeLogo(brands[(shown[c] + 1) % brands.length]));
  };
  let logosReady = false;
  Promise.all([...new Set(clients.flatMap(brand => [brand.logo.light, brand.logo.dark]))].map(file => {
    const image = new Image(); image.src = `/clients/${file}`; return image.decode();
  })).then(() => { logosReady = true; start(); }).catch(error => console.error('Client logo preload failed', error));
  const order = () => { const rest = Array.from({length: cols - 1}, (_, i) => i + 1); for (let i = rest.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [rest[i], rest[j]] = [rest[j], rest[i]]; } return [...rest, 0]; };
  const stop = () => { clearInterval(timer); timer = 0; };
  const start = () => { if (!logosReady || !visible || hovered || timer) return; timer = window.setInterval(async () => {
    if (preparing) return;
    if (!queue.length) queue = order();
    const c = queue[0]!, reel = reels[c], brands = clients.filter((_, i) => i % cols === c);
    preparing = true;
    try {
      const next = makeLogo(brands[(shown[c] + 2) % brands.length]);
      await Promise.all([...next.querySelectorAll('img')].map(img => img.decode()));
      if (!visible || hovered || !timer || reel !== reels[c] || queue[0] !== c) return;
      queue.shift(); reel.append(next); reel.dataset.rolling = '';
      reel.ontransitionend = (event) => { if (event.target !== reel) return; shown[c]++; reel.firstElementChild?.remove(); delete reel.dataset.rolling; };
    } catch (error) { console.error('Client logo roll preparation failed', error); }
    finally { preparing = false; }
  }, 1400); };
  updateCols();
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; visible ? start() : stop(); }); observer.observe(strip);
    strip.addEventListener('pointerenter', () => { hovered = true; stop(); }); strip.addEventListener('pointerleave', () => { hovered = false; start(); });
  }
  for (const query of ['(min-width: 64rem)', '(min-width: 40rem)']) matchMedia(query).addEventListener('change', () => { updateCols(); stop(); start(); });
  window.addEventListener('resize', () => { updateCols(); });
}
}
</script>
