---
// The gig cards as a shelf of book spines (after 21st.dev's Elastic Gallery, 2026-11-03): on desktop with a mouse,
// each closed gig is a spine with its image at the top and its short name running down; the hovered or focused one opens
// into the full card. Nothing cross-fades: the image grows down from spine band to thumbnail while the name shrinks
// away and the card's text, at a fixed width so it never reflows, rises into place. Touch screens
// and narrower windows get the plain card grid; reduced motion opens books without the animation.
import GigCard from './GigCard.astro';
interface Gig { category: string; title: string; reviews: string; price: string }
interface Props { gigs: Gig[]; avatar: ImageMetadata; seller: string; badge: string; rating: string; extra?: string }
const { gigs, ...card } = Astro.props;
---
<div class="gig-shelf" data-gig-shelf style={`--books: ${gigs.length}`}>
  <span class="gig-shelf-glow" aria-hidden="true"></span>
  {gigs.map((gig, i) => <div class="gig-book" tabindex="0" data-open={i === 0 ? '' : undefined}>
    <GigCard {...card} {...gig} />
    <span class="gig-spine" aria-hidden="true">{gig.category}</span>
  </div>)}
</div>
<script>
  for (const shelf of document.querySelectorAll<HTMLElement>('[data-gig-shelf]')) {
    const books = [...shelf.querySelectorAll<HTMLElement>('.gig-book')];
    const open = (book: HTMLElement) => { for (const other of books) other.toggleAttribute('data-open', other === book); };
    for (const book of books) {
      book.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') open(book); });
      book.addEventListener('focusin', () => open(book));
    }
    // The backlight (after vercel.com's triangle): a blurred glow behind the solid books trails the mouse, showing
    // round the open card and through the gaps between spines.
    let x = 0, y = 0, tx = 0, ty = 0, frame = 0, lit = false;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const tick = () => {
      const k = still.matches ? 1 : 0.1;
      x += (tx - x) * k; y += (ty - y) * k;
      const r = shelf.getBoundingClientRect();
      shelf.style.setProperty('--gx', `${x - r.left}px`); shelf.style.setProperty('--gy', `${y - r.top}px`);
      frame = lit || Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(tick) : 0;
    };
    shelf.addEventListener('pointermove', event => {
      if (event.pointerType !== 'mouse') return;
      tx = event.clientX; ty = event.clientY;
      if (!lit) { if (!frame) { x = tx; y = ty; } lit = true; shelf.toggleAttribute('data-lit', true); }
      if (!frame) frame = requestAnimationFrame(tick);
    });
    shelf.addEventListener('pointerleave', () => { lit = false; shelf.toggleAttribute('data-lit', false); });
  }
</script>
<style>
  .gig-shelf { display: grid; column-gap: var(--gutter); row-gap: 40px; }
  .gig-spine { display: none; }
  @media (min-width: 640px) { .gig-shelf { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .gig-shelf { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1280px) { .gig-shelf { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    /* --pace stretches every duration and delay together (owner, 2026-11-03: 1.6x the Elastic Gallery's). */
    .gig-shelf { --book-open: 300px; --thumb-open: calc(var(--book-open) * 769 / 1280); --pace: 1.6; --glow: rgb(255 195 0 / 0.5); --halo: rgb(255 195 0 / 0.4); --book-fill: color-mix(in srgb, var(--color-fg-max) 6%, var(--color-canvas)); --spine: calc((100% - var(--book-open) - (var(--books) - 1) * 8px) / (var(--books) - 1)); --book-ease: calc(0.7s * var(--pace)) cubic-bezier(0.25, 1, 0.5, 1); position: relative; display: flex; gap: 8px; }
    /* Exact widths, not flex shares: the opening and closing books trade the same width every frame, so the rest stay still. */
    .gig-book {
      position: relative; z-index: 1; flex: 0 0 var(--spine); min-width: 0; border-radius: 12px; outline-offset: 4px;
      filter: drop-shadow(0 0 0 transparent) drop-shadow(0 0 0 transparent);
      transition: flex var(--book-ease), filter calc(0.5s * var(--pace)) ease;
    }
    .gig-book[data-open] { flex: 0 0 var(--book-open); }
    /* Solid books, spine and open card alike, so the light shows only round them. */
    .gig-book :global(.gig) { background: var(--book-fill); }
    /* The open card's halo hugs its outline while the mouse is on the shelf. */
    .gig-shelf[data-lit] .gig-book[data-open] { filter: drop-shadow(0 0 14px var(--halo)) drop-shadow(0 0 44px color-mix(in srgb, var(--halo) 50%, transparent)); }
    .gig-shelf-glow {
      position: absolute; z-index: 0; left: var(--gx, 50%); top: var(--gy, 50%); width: 420px; height: 420px; translate: -50% -50%; pointer-events: none;
      border-radius: 50%; background: radial-gradient(closest-side, var(--glow), transparent); filter: blur(40px); opacity: 0;
      transition: opacity calc(0.5s * var(--pace)) ease;
    }
    .gig-shelf[data-lit] .gig-shelf-glow { opacity: 1; }
    /* The band grows into the thumbnail while its margin gives the same height back, so the shelf never changes height. */
    .gig-book :global(.gig-thumb) { aspect-ratio: auto; height: 96px; margin-bottom: calc(var(--thumb-open) - 96px); transition: height var(--book-ease), margin-bottom var(--book-ease); }
    .gig-book[data-open] :global(.gig-thumb) { height: var(--thumb-open); margin-bottom: 0; }
    .gig-book :global(.gig-thumb > *) { opacity: 0; transition: opacity calc(0.2s * var(--pace)) ease; }
    .gig-book[data-open] :global(.gig-thumb > *) { opacity: 1; transition: opacity calc(0.4s * var(--pace)) ease calc(0.3s * var(--pace)); }
    .gig-book :global(.gig-body) { width: var(--book-open); opacity: 0; translate: 0 32px; transition: opacity calc(0.2s * var(--pace)) ease, translate calc(0.2s * var(--pace)) ease; }
    .gig-book[data-open] :global(.gig-body) { opacity: 1; translate: 0 0; transition: opacity calc(0.5s * var(--pace)) ease calc(0.15s * var(--pace)), translate var(--book-ease) calc(0.1s * var(--pace)); }
    /* The spine's name sits under the image band, bold and tracked, reading down from the foot. */
    .gig-spine {
      position: absolute; inset: 96px 0 0; display: flex; justify-content: flex-end; align-items: center; padding: 16px 0 28px; pointer-events: none;
      writing-mode: vertical-rl; font-family: var(--font-display); font-size: 14px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      line-height: 1; white-space: nowrap; color: var(--color-fg-max);
      transition: opacity calc(0.4s * var(--pace)) ease calc(0.35s * var(--pace)), scale calc(0.4s * var(--pace)) ease calc(0.35s * var(--pace));
    }
    .gig-book[data-open] .gig-spine { opacity: 0; scale: 0.5; transition: opacity calc(0.2s * var(--pace)) ease, scale calc(0.3s * var(--pace)) ease; }
  }
  .gig-shelf-glow { display: none; }
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) { .gig-shelf-glow { display: block; } }
  /* Light mode: amber, and the card's gray a shade darker so it stays above 4.5:1 on the book fill. */
  :global([data-theme="light"]) .gig-shelf { --glow: rgb(245 158 11 / 0.45); --halo: rgb(245 158 11 / 0.45); }
  :global([data-theme="light"]) .gig-shelf :global(.gig) { --gig-muted: #66686f; }
  @media (prefers-reduced-motion: reduce) {
    .gig-book, .gig-book :global(*) { transition: none !important; }
  }
</style>
