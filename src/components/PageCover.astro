---
interface Props { word: string; ink: number; intro: string }
const { word, ink, intro } = Astro.props;
---
<section class="page-cover relative -mt-16 overflow-x-clip [container-type:inline-size]" style={`--ink:${ink}`}>
  <div class="flex min-h-svh flex-col justify-end pt-16">
    <p class="page-cover-intro px-gutter pb-8 type-lead text-fg-2"><span class="block max-w-[36ch]">{intro}</span></p>
    <h1 class="page-cover-word text-fg-max">{word.endsWith('.') ? <>{word.slice(0, -1)}<span class="text-yellow-splash">.</span></> : word}</h1>
  </div>
  <div class="page-cover-overhang" aria-hidden="true"></div>
  <slot />
</section>
