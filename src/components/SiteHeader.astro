---
import ThemeToggle from './ThemeToggle.astro';
import Wordmark from './Wordmark.astro';
import { FIVERR_INBOX_URL, FIVERR_PROFILE_URL } from '@/lib/content';
interface Props { pathname: string; initialOverMedia?: boolean }
const { pathname } = Astro.props;
const aboutHero = /^\/about\/?$/.test(pathname);
const initialOverMedia = aboutHero || Astro.props.initialOverMedia === true;
const nav = [{href:'/',label:'Home'},{href:'/proof',label:'Proof'},{href:'/brands',label:'Brands'},{href:'/blog',label:'Blog'},{href:'/about',label:'About'}];
---
<header data-site-header data-about-hero={aboutHero ? '' : undefined} class:list={["sticky top-0 z-50 transition-[translate,background-color] duration-300 ease-out has-focus-visible:translate-y-0", !initialOverMedia && "bg-bg/50 backdrop-blur-[48px]"]} data-over-media={initialOverMedia ? '' : undefined}>
 <div class="shell flex h-16 items-center justify-between"><a href="/" aria-label="emmaki home" class="flex h-11 items-center"><Wordmark class="w-[88px] sm:w-[120px]"/></a>
  <div class="-mr-3 flex items-center"><span data-local-clock class="items-baseline gap-1.5 whitespace-nowrap font-heading text-sm mr-4 hidden sm:flex"><span data-local-clock-value class="font-medium text-fg-max"><span data-local-clock-time class="tabular-nums">00:00</span> EET</span><span data-local-clock-status class="font-thin uppercase text-fg-max">Offline</span></span><ThemeToggle/><button type="button" aria-label="Open menu" aria-haspopup="dialog" aria-expanded="false" class="icon-action" data-menu-open><svg class="size-5" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button></div>
 </div>
 <dialog aria-labelledby="site-menu-title" class="site-menu fixed inset-y-0 left-auto right-0 m-0 h-dvh max-h-none w-full max-w-[720px] overflow-clip border-0 bg-transparent p-0 outline-none" data-site-menu>
  <div aria-hidden="true" class="site-menu-backdrop fixed inset-0 z-[60] bg-black/55 backdrop-blur-sm dark:bg-black/30" data-menu-backdrop></div>
  <div aria-hidden="true" class="absolute inset-0 bg-yellow-splash motion-reduce:hidden" data-menu-layer="0"></div><div aria-hidden="true" class="absolute inset-0 bg-fg-muted dark:bg-raised motion-reduce:hidden" data-menu-layer="1"></div>
  <div class="relative z-[61] flex h-full flex-col overflow-y-auto bg-bg dark:bg-bg-2 px-[var(--gutter)] pb-10 pt-3 shadow-2xl motion-reduce:[animation:none!important] sm:px-12" data-menu-layer="2">
   <div class="flex h-11 items-center justify-between"><div id="site-menu-title" class="sr-only" role="heading" aria-level="2">Site menu</div><a href="/" aria-label="emmaki home"><Wordmark class="w-[88px]"/></a><button type="button" aria-label="Close menu" class="icon-action" data-menu-close><svg class="size-5" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
   <div class="flex flex-1 flex-col justify-center gap-e2"><div class="flex items-center gap-8 [--menu-icon:clamp(2rem,3.5vw,3rem)]"><ThemeToggle class="size-auto" iconClass="size-(--menu-icon)"/><a href={FIVERR_INBOX_URL} target="_blank" rel="noopener" aria-label="Message emmaki on Fiverr (opens in a new tab)" class="text-fg-2 quiet-link"><svg class="size-(--menu-icon)" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/></svg></a><a href={FIVERR_PROFILE_URL} target="_blank" rel="noopener" aria-label="emmaki on Fiverr (opens in a new tab)" class="text-fg-2 quiet-link"><svg class="size-(--menu-icon)" viewBox="0 0 24 24" aria-hidden="true"><mask id="menu-fiverr-mask"><circle cx="12" cy="12" r="12" fill="#fff"/><g fill="#000" transform="translate(7.6 -6.67) scale(1.565)"><path d="M.908 15.44H2.51v-3.558h1.524v3.558h1.591v-4.874H2.51v-.302c0-.332.235-.536.606-.536h.918V8.412H2.85c-1.162 0-1.943.712-1.943 1.755v.4H0v1.316h.908v3.558z"/><circle cx="4.85" cy="9.15" r=".78"/></g></mask><circle cx="12" cy="12" r="12" fill="currentColor" mask="url(#menu-fiverr-mask)"/></svg></a></div>
    <nav aria-label="Main menu"><ul class="w-full space-y-1">{nav.map(({href,label}) => {const active = href === '/' ? pathname === '/' : pathname.startsWith(href); return <li><a href={href} aria-current={active ? 'page' : undefined} class={`flex min-h-16 items-center whitespace-nowrap type-mega [font-size:min(var(--type-display-mega-size),10.5dvh)] quiet-link ${active ? 'text-fg-max' : 'text-fg-2'}`}><span class="menu-link-label">{label}</span></a></li>;})}</ul></nav>
   </div>
  </div>
 </dialog>
</header>

<script>
const header = document.querySelector<HTMLElement>('[data-site-header]'), dialog = header?.querySelector<HTMLDialogElement>('[data-site-menu]'), openButton = header?.querySelector<HTMLButtonElement>('[data-menu-open]'), closeButton = header?.querySelector<HTMLButtonElement>('[data-menu-close]');
if (header && dialog && openButton && closeButton) {
 const ease = 'cubic-bezier(0.65, 0.01, 0.05, 0.99)', reveal = 0.575;
 const close = () => { if (dialog.open) dialog.close(); document.body.style.removeProperty('overflow'); };
 openButton.addEventListener('click', () => { if (hidden) header.classList.remove('-translate-y-full'); dialog.showModal(); openButton.setAttribute('aria-expanded','true'); document.body.style.overflow = 'hidden'; const backdrop = dialog.querySelector<HTMLElement>('[data-menu-backdrop]'); if (backdrop) backdrop.style.animation = `site-menu-backdrop-in 0.7s ${ease} both`; dialog.querySelectorAll<HTMLElement>('[data-menu-layer]').forEach((layer, i) => { layer.style.animation = `menu-slide-in ${reveal}s ${ease} ${i * .12}s both`; }); requestAnimationFrame(() => requestAnimationFrame(() => { const trigger = openButton.getBoundingClientRect(), panel = dialog.getBoundingClientRect(); closeButton.style.top = `${trigger.top - panel.top}px`; closeButton.style.right = `${panel.right - trigger.right}px`; })); });
 closeButton.addEventListener('click', close);
 dialog.addEventListener('click', event => { if (event.target === dialog || (event.target as Element).hasAttribute('data-menu-backdrop')) close(); });
 dialog.addEventListener('close', () => { document.body.style.removeProperty('overflow'); openButton.setAttribute('aria-expanded','false'); if (hidden) header.classList.add('-translate-y-full'); });
 dialog.addEventListener('keydown', event => { if (event.key !== 'Tab') return; const items = [...dialog.querySelectorAll<HTMLElement>('a[href],button:not([disabled])')].filter(el => el.offsetParent !== null); if (!items.length) return; const first = items[0], last = items.at(-1)!; if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); } else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); } });
 dialog.querySelectorAll<HTMLAnchorElement>('nav a').forEach(link => link.addEventListener('click', close));
 let last = scrollY, frame = 0, reset = true, hidden = false;
 const media = document.querySelector('[data-under-header]'), cover = document.querySelector('[data-covers-media]');
 const onScroll = () => { if (frame) return; frame = requestAnimationFrame(() => { frame = 0; if (reset) { header.classList.remove('-translate-y-full'); reset = false; } const overMedia = !!media && media.getBoundingClientRect().bottom > 64 && (!cover || cover.getBoundingClientRect().top > 64); if (overMedia) header.setAttribute('data-over-media', ''); else header.removeAttribute('data-over-media'); header.classList.toggle('bg-bg/50', !overMedia); header.classList.toggle('backdrop-blur-[48px]', !overMedia); const y = scrollY; if (Math.abs(y-last)<8) return; hidden = y>last && y>64; header.classList.toggle('-translate-y-full', hidden && !dialog.open); last=y; }); };
 onScroll(); addEventListener('scroll', onScroll, {passive:true});
}
</script>

<style>
  /* About uses the existing over-media lifetime, with the page's own theme ink. */
  [data-about-hero][data-over-media] {
    background: transparent;
    backdrop-filter: none;
    animation: none;
  }
  :global([data-theme="light"]) [data-about-hero][data-over-media] {
    animation: none;
    --color-text-maximum: var(--cover-ink-max);
    --color-text-secondary: var(--cover-ink-2);
    --color-focus: var(--cover-ink-max);
  }
  [data-about-hero][data-over-media] [data-local-clock],
  [data-about-hero][data-over-media] > .shell .icon-action {
    filter: drop-shadow(0 0 2px var(--color-bg)) drop-shadow(0 0 5px var(--color-bg));
  }
</style>
