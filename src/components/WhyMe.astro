---
interface Figure { kind: 'figure'; figure: string; label: string; accent?: boolean; dynamicYear?: boolean }
interface Note { kind: 'note'; text: string; label: string; accent?: boolean }
interface Quote { kind: 'quote'; testimonial: { quote: string; name: string; role: string; company: string; photo?: string } }
interface Pair { kind: 'pair'; figures: { figure: string; label: string }[]; accent?: boolean }
interface Logos { kind: 'logos'; label: string; note: string; logos: { name: string; light: string; dark: string; height: number }[] }
type Item = Figure | Pair | Note | Quote | Logos;
interface Props { kicker: string; credibility: Item[] }
const { kicker, credibility } = Astro.props;
---
<section class="shell">
  <h2 class="type-meta text-fg-2 uppercase">{kicker}</h2>
  <ul class="why-me-proof">
    {credibility.map((c, i) => <li class="why-me-proof-box" data-accent={'accent' in c && c.accent ? '' : undefined}>
      {i === 0 && <span class="why-me-poster why-me-poster-1" aria-hidden="true"><svg viewBox="0 0 320 320" preserveAspectRatio="xMidYMid slice" fill="none"><g class="why-me-disc"><circle cx="254" cy="22" r="132" fill="currentColor"/><circle cx="254" cy="22" r="87" fill="var(--color-yellow-splash)"/><circle cx="254" cy="22" r="59" stroke="var(--color-yellow-splash)" stroke-width="2"/><path d="M254 -115V155M117 22H390" stroke="var(--color-yellow-splash)" stroke-width="2"/></g><path d="M-40 128H200M-40 140H160M-40 152H120" stroke="currentColor" stroke-opacity=".5"/><path class="why-me-slash" d="M273 114L211 208" stroke="currentColor" stroke-width="26"/></svg></span>}
      {i === 1 && <span class="why-me-poster why-me-poster-2" aria-hidden="true"><svg viewBox="0 0 320 320" preserveAspectRatio="xMidYMid slice" fill="none"><g class="why-me-moire-base" stroke="currentColor" stroke-opacity=".65">{Array.from({length:92},(_,n)=><path d={`M-180 ${n*7-160}H500`}/>)}</g><g class="why-me-moire-slide" stroke="currentColor" stroke-opacity=".85">{Array.from({length:92},(_,n)=><path d={`M-180 ${n*7-160}H500`}/>)}</g></svg></span>}
      {i === 2 && <canvas data-halftone class="why-me-poster why-me-poster-3" aria-hidden="true"></canvas>}
      {i === 3 && <span class="why-me-poster why-me-poster-4" aria-hidden="true"><svg viewBox="0 0 320 320" preserveAspectRatio="xMidYMid slice" fill="none"><g class="why-me-rings" stroke="currentColor">{[38,66,94,122,150,178,206,234,262,290,318,346,374,402].map((r,n)=><circle cx="318" cy="318" r={r} stroke-width={n===4?22:n%3===0?3:1} stroke-opacity={n%3===0||n===4?1:.45}/>)}</g></svg></span>}
      {i === 5 && <span class="why-me-poster why-me-poster-6" aria-hidden="true"><svg viewBox="0 0 320 320" preserveAspectRatio="xMidYMid slice" fill="none"><path d="M0 0H320V320H0ZM64 0V320M128 0V320M192 0V320M256 0V320M0 64H320M0 128H320M0 192H320M0 256H320" stroke="currentColor" stroke-opacity=".35"/>{[4,8,0,19,21,12,23,6].map((cell,n)=><rect class={`why-me-module why-me-module-${n}`} x={(cell%5)*64} y={Math.floor(cell/5)*64} width="64" height="64" fill="currentColor" fill-opacity={n%3===0?1:.3}/>)}</svg></span>}
      {i === 6 && <span class="why-me-poster why-me-poster-7" aria-hidden="true"><svg viewBox="0 0 320 320" preserveAspectRatio="xMidYMid slice" fill="none"><defs><mask id="astro-why-me-quote-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width="420" height="400"><path class="why-me-quote-stroke" d="M185 126V231Q185 293 111 324M331 126V231Q331 293 257 324" pathLength="1" stroke="white" stroke-width="116"/></mask></defs><g mask="url(#astro-why-me-quote-reveal)" fill="currentColor"><path d="M128 108H242V226Q242 317 138 366L108 310Q174 278 174 232H128ZM274 108H388V226Q388 317 284 366L254 310Q320 278 320 232H274Z"/></g><path d="M112 96H254V227M258 96H400V227" stroke="currentColor" stroke-opacity=".4"/></svg></span>}
      {c.kind === 'pair' ? c.figures.map((f) => <div class="why-me-proof-block"><p class="why-me-proof-value">{f.figure}</p><p class="why-me-proof-label type-meta uppercase">{f.label}</p></div>) : c.kind === 'logos' ? <div class="why-me-proof-logos"><p class="why-me-proof-value">{c.label}</p><div class="why-me-backers-group"><ul class="why-me-backers">{c.logos.map((logo) => <li style={`--backer-height: ${logo.height}px`}><span class="sr-only">{logo.name}</span><img src={`/clients/${logo.light}`} alt="" class="why-me-backer-on-light" loading="lazy" decoding="async" /><img src={`/clients/${logo.dark}`} alt="" aria-hidden="true" class="why-me-backer-on-dark" loading="lazy" decoding="async" /></li>)}</ul><p class="why-me-proof-label type-meta uppercase">{c.note}</p></div></div> : c.kind === 'quote' ? <figure class="why-me-proof-quote"><blockquote class="why-me-proof-value">“{c.testimonial.quote}”</blockquote><figcaption class="why-me-proof-by">{c.testimonial.photo && <img src={`/testimonials/${c.testimonial.photo}`} alt="" width="56" height="56" loading="lazy" decoding="async" class="why-me-proof-photo" />}<span class="flex flex-col"><span class="why-me-proof-name">{c.testimonial.name}</span><span>{c.testimonial.role}</span><span>{c.testimonial.company}</span></span></figcaption></figure> : <div class="why-me-proof-block"><p class="why-me-proof-value">{c.kind === 'note' ? c.text : c.dynamicYear ? <span data-years-since="2013">{new Date().getFullYear() - 2013}</span> : c.figure}</p><p class="why-me-proof-label type-meta uppercase">{c.label}</p></div>}
    </li>)}
  </ul>
</section>
<script>
const canvas = document.querySelector<HTMLCanvasElement>('[data-halftone]');
const box = canvas?.closest<HTMLElement>('.why-me-proof-box'); const context = canvas?.getContext('2d');
if (canvas && box && context) {
  const enabled = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  let frame = 0, active = false, entered = 0, bounds = box.getBoundingClientRect(), targetX=160, targetY=100, x=160, y=100, previous=0;
  const stop = () => { active=false; cancelAnimationFrame(frame); frame=0; context.clearRect(0,0,320,320); };
  const draw = (now:number) => { if(!active)return; const follow=1-Math.exp(-Math.min(now-previous,64)/85); previous=now; x+=(targetX-x)*follow; y+=(targetY-y)*follow; const elapsed=now-entered, reach=Math.min(440,24+elapsed*.55); context.clearRect(0,0,320,320); context.fillStyle=getComputedStyle(canvas).color; context.beginPath(); for(let row=0;row<23;row++)for(let column=0;column<23;column++){const px=column*15,py=row*15,distance=Math.hypot(px-x,py-y),density=Math.max(0,1-distance/reach),wave=.5+.5*Math.cos(distance/34-elapsed/1100),radius=.65+density*(2.5+wave*3.1);context.moveTo(px+radius,py);context.arc(px,py,radius,0,Math.PI*2);} context.fill(); frame=requestAnimationFrame(draw); };
  const move=(event:PointerEvent)=>{bounds=box.getBoundingClientRect();targetX=(event.clientX-bounds.left)/bounds.width*320;targetY=(event.clientY-bounds.top)/bounds.height*320;};
  const start=(event?:PointerEvent)=>{if(!enabled.matches||document.hidden||active)return;bounds=box.getBoundingClientRect();const ratio=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(bounds.width*ratio);canvas.height=Math.round(bounds.height*ratio);context.setTransform(canvas.width/320,0,0,canvas.height/320,0,0);if(event)move(event);x=targetX;y=targetY;active=true;previous=entered=performance.now();frame=requestAnimationFrame(draw);};
  const refresh=()=>{stop();if(box.matches(':hover'))start();};
  box.addEventListener('pointerenter',start);box.addEventListener('pointermove',move,{passive:true});box.addEventListener('pointerleave',stop);box.addEventListener('pointercancel',stop);enabled.addEventListener('change',refresh);document.addEventListener('visibilitychange',refresh);window.addEventListener('resize',refresh);
}
</script>
<script>
const years = document.querySelector<HTMLElement>('[data-years-since]');
if (years) years.textContent = String(new Date().getFullYear() - Number(years.dataset.yearsSince));
</script>
