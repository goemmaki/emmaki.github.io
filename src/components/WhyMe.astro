---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
interface Figure { kind: 'figure'; figure: string; label: string; accent?: boolean; dynamicYear?: boolean }
interface Note { kind: 'note'; text: string; label: string; accent?: boolean }
interface Quote { kind: 'quote'; testimonial: { quote: string; name: string; role: string; company: string; photo?: ImageMetadata } }
interface Pair { kind: 'pair'; figures: { figure: string; label: string }[]; accent?: boolean }
interface Logos { kind: 'logos'; label: string; note: string; logos: { name: string; light: string; dark: string; height: number }[] }
type Item = Figure | Pair | Note | Quote | Logos;
interface Props { kicker: string; heading: string; credibility: Item[] }
const { kicker, heading, credibility } = Astro.props;
---
<section class="shell">
  <p class="type-meta text-fg-2 uppercase">{kicker}</p>
  <h2 class="mt-6 max-w-[36ch] type-h2 text-fg-max">{heading}</h2>
  <ul class="why-me-proof">
    {credibility.map((c, i) => <li class="why-me-proof-box">
      {i === 1 && <span class="why-me-papers" aria-hidden="true"><span></span><span></span><span></span></span>}
      {i === 5 && <span class="why-me-city" aria-hidden="true">TLV</span>}
      {i === 2 && <canvas data-halftone class="why-me-poster why-me-poster-3" aria-hidden="true"></canvas>}
      {c.kind === 'pair' ? c.figures.map((f) => <div class="why-me-proof-block"><p class="why-me-proof-value">{f.figure}</p><p class="why-me-proof-label type-meta uppercase">{f.label}</p></div>) : c.kind === 'logos' ? <div class="why-me-proof-logos"><p class="why-me-proof-value">{c.label}</p><div class="why-me-backers-group"><ul class="why-me-backers">{c.logos.map((logo) => <li style={`--backer-height: ${logo.height}px`}><span class="sr-only">{logo.name}</span><img src={`/clients/${logo.light}`} alt="" class="why-me-backer-on-light" loading="lazy" decoding="async" /><img src={`/clients/${logo.dark}`} alt="" aria-hidden="true" class="why-me-backer-on-dark" loading="lazy" decoding="async" /></li>)}</ul><p class="why-me-proof-label type-meta uppercase">{c.note}</p></div></div> : c.kind === 'quote' ? <figure class="why-me-proof-quote"><blockquote class="why-me-proof-value">“{c.testimonial.quote}”</blockquote><figcaption class="why-me-proof-by">{c.testimonial.photo && <Picture src={c.testimonial.photo} formats={['avif', 'webp']} fallbackFormat="webp" widths={[56, 112, 168]} sizes="56px" width={56} height={56} alt="" loading="lazy" decoding="async" class="why-me-proof-photo" />}<span class="flex flex-col"><span class="why-me-proof-name">{c.testimonial.name}</span><span>{c.testimonial.role}</span><span>{c.testimonial.company}</span></span></figcaption></figure> : <div class="why-me-proof-block"><p class="why-me-proof-value">{c.kind === 'note' ? c.text : c.dynamicYear ? <span data-years-since="2013">{new Date().getFullYear() - 2013}</span> : c.figure}</p><p class="why-me-proof-label type-meta uppercase">{c.label}</p></div>}
    </li>)}
  </ul>
</section>
<script>
const canvas = document.querySelector<HTMLCanvasElement>('[data-halftone]');
const box = canvas?.closest<HTMLElement>('.why-me-proof-box'); const context = canvas?.getContext('2d');
if (canvas && box && context) {
  const enabled = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  let frame = 0, active = false, entered = 0, bounds = box.getBoundingClientRect(), targetX=160, targetY=100, x=160, y=100, previous=0;
  const stop = () => { active=false; cancelAnimationFrame(frame); frame=0; context.clearRect(0,0,320,320); };
  const draw = (now:number) => { if(!active)return; const follow=1-Math.exp(-Math.min(now-previous,64)/85); previous=now; x+=(targetX-x)*follow; y+=(targetY-y)*follow; const elapsed=now-entered, reach=Math.min(440,24+elapsed*.55); context.clearRect(0,0,320,320); context.fillStyle=getComputedStyle(canvas).color; context.beginPath(); for(let row=0;row<23;row++)for(let column=0;column<23;column++){const px=column*15,py=row*15,distance=Math.hypot(px-x,py-y),density=Math.max(0,1-distance/reach),wave=.5+.5*Math.cos(distance/34-elapsed/1100),radius=.65+density*(2.5+wave*3.1);context.moveTo(px+radius,py);context.arc(px,py,radius,0,Math.PI*2);} context.fill(); frame=requestAnimationFrame(draw); };
  const move=(event:PointerEvent)=>{bounds=box.getBoundingClientRect();targetX=(event.clientX-bounds.left)/bounds.width*320;targetY=(event.clientY-bounds.top)/bounds.height*320;};
  const start=(event?:PointerEvent)=>{if(!enabled.matches||document.hidden||active)return;bounds=box.getBoundingClientRect();const ratio=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(bounds.width*ratio);canvas.height=Math.round(bounds.height*ratio);context.setTransform(canvas.width/320,0,0,canvas.height/320,0,0);if(event)move(event);x=targetX;y=targetY;active=true;previous=entered=performance.now();frame=requestAnimationFrame(draw);};
  const refresh=()=>{stop();if(box.matches(':hover'))start();};
  box.addEventListener('pointerenter',start);box.addEventListener('pointermove',move,{passive:true});box.addEventListener('pointerleave',stop);box.addEventListener('pointercancel',stop);enabled.addEventListener('change',refresh);document.addEventListener('visibilitychange',refresh);window.addEventListener('resize',refresh);
}
</script>
<script>
const years = document.querySelector<HTMLElement>('[data-years-since]');
if (years) years.textContent = String(new Date().getFullYear() - Number(years.dataset.yearsSince));
</script>
