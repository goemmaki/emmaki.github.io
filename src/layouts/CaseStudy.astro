---
// The default layout for a work entry (presentation: case-study): title, the client frame (results,
// testimonial, company facts), then a contents sidebar beside the opening ("Long story short…"), the MDX
// body (sectioned by collection-sections.ts) and the FAQs.
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import PageClosing from '../components/PageClosing.astro';
import CaseFrame from '../components/CaseFrame.astro';
import PostIcon from '../components/blog/PostIcon.astro';
import Faq from '../components/Faq.astro';
import PostToc from '../components/blog/PostToc.astro';
import { BRANDS } from '@/lib/content';
import { headingId, pageReadingMinutes, POST_FAQ_LABEL } from '@/lib/post-format';
import { bodyText, sectionHeadingClass } from '@/lib/prose';

interface Props { entry: CollectionEntry<'work'>; headings: MarkdownHeading[] }
const { entry: { data, body = '' }, headings } = Astro.props;
const client = data.client ? BRANDS.find((brand) => brand.name === data.client) : undefined;
if (client && !client.color) throw new Error(`Case study needs ${client.name}'s brand color`);
const companyFacts = [['Industry', data.industry], ['Headquarters', data.headquarters], ['Company size', data.companySize], ['Annual revenue', data.annualRevenue]].filter((fact): fact is [string, string] => Boolean(fact[1]));
const OPENING_LABEL = 'Long story short…';
const OPENING_ID = 'long-story-short';
const minutes = pageReadingMinutes(body, [data.title, data.opening], data.faqs);
const toc = [{ id: OPENING_ID, text: OPENING_LABEL }, ...headings.filter(({ depth }) => depth === 2).map(({ slug, text }) => ({ id: slug, text })), ...(data.faqs.length ? [{ id: headingId(POST_FAQ_LABEL), text: POST_FAQ_LABEL }] : [])];
---
<Base pageTitle={data.shortTitle}>
  {data.noindex && <meta slot="head" name="robots" content="noindex" />}
  <section class="shell pt-[clamp(8rem,20svh,11rem)]">
    <nav aria-label="Breadcrumb" class="type-meta uppercase text-fg-2"><ol class="flex min-w-0 items-center gap-2"><li class="flex shrink-0"><a href="/" aria-label="Home" class="quiet-link"><svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg></a></li><li aria-hidden="true"><svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li><li class="shrink-0"><a href="/proof" class="quiet-link">Case studies</a></li><li aria-hidden="true"><svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li><li aria-current="page" class="min-w-0 max-w-[36ch] truncate text-fg-max">{data.shortTitle}</li></ol></nav>
    <h1 class="mt-8 max-w-[22ch] font-heading font-normal text-[clamp(2rem,2.8vw,2.5rem)] leading-[1.15] tracking-[-0.03em] text-fg-max text-pretty">{data.title}</h1>
    {client && <CaseFrame brandColor={client.color!} clientName={client.name} facts={companyFacts} />}
  </section>
  <div class="shell mt-e2 grid gap-y-e1 lg:grid-cols-12">
    <aside aria-labelledby="toc-title" class="hidden lg:col-span-3 lg:block lg:self-start lg:sticky lg:top-28"><p class="mb-8 flex items-center gap-2 type-meta text-fg-2"><PostIcon name="clock"/>{minutes} min read</p><h2 id="toc-title" class="sr-only">On this page</h2><PostToc entries={toc} /></aside>
    <div class="max-w-[700px] lg:col-span-8 lg:col-start-5">
      <section aria-labelledby={OPENING_ID} class="mb-e2"><h2 id={OPENING_ID} tabindex="-1" class={sectionHeadingClass}>{OPENING_LABEL}</h2><p class="mt-6 type-h3 text-[1.25rem] font-normal text-fg text-pretty">{data.opening}</p></section>
      <slot />
      {data.faqs.length > 0 && <section aria-labelledby={headingId(POST_FAQ_LABEL)} class="mt-e2"><h2 id={headingId(POST_FAQ_LABEL)} tabindex="-1" class={sectionHeadingClass}>{POST_FAQ_LABEL}</h2><Faq faqs={data.faqs} bodyText={bodyText} /></section>}
    </div>
  </div>
  <PageClosing aiQuestion={data.aiQuestion} />
</Base>
