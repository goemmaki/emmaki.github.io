---
import Base from '../layouts/Base.astro';
import ClientSlots from '../components/ClientSlots.astro';
import TestimonialGlobe from '../components/TestimonialGlobe.astro';
import Statement from '../components/Statement.astro';
import WhyMe from '../components/WhyMe.astro';
import PageClosing from '../components/PageClosing.astro';
import HeroPoster from '../components/HeroPoster.astro';
import CautionTape from '../components/CautionTape.astro';
import GigShelf from '../components/GigShelf.astro';
import ApproachAccordion from '../components/ApproachAccordion.astro';
import gigAvatar from '@/assets/gig/emma.png';
import salesCopyThumb from '@/assets/gig/sales-copy.png';
import fiverrOptimisationThumb from '@/assets/gig/fiverr-optimisation.png';
import cannonBrooke from '@/assets/testimonials/cannon-brooke.webp';
import { heroPortrait } from '@/lib/hero-portrait';
import { TESTIMONIALS } from '@/lib/content';
const portrait = await heroPortrait();
// The globe opens on Shilo and turns west, so the first stops are the strongest run (Shilo, Antónia,
// Mark, René, Indre); next/previous and the 01 / 11 count follow the same order as the spin.
const globeLead = TESTIMONIALS.find((t) => t.name === 'Shilo Abramovicz');
if (globeLead?.lng === undefined) throw new Error('The testimonial globe needs its lead review, Shilo Abramovicz, with a longitude');
const westOf = (lng: number) => (((globeLead.lng! - lng) % 360) + 360) % 360;
const globeReviews = [...TESTIMONIALS].sort((a, b) => westOf(a.lng!) - westOf(b.lng!));
const links = [
  { text: 'get it', href: '/proof', metric: '00%', summary: 'Placeholder: what changed for the client', client: 'Client one' },
  { text: 'want it', href: '/proof', metric: '0 weeks', summary: 'Placeholder: what was written, and for what', client: 'Client two' },
  { text: 'buy it', href: '/proof', metric: '000+', summary: 'Placeholder: the result in one line', client: 'Client three' },
];
const credibility = [
  { kind: 'pair' as const, accent: true, figures: [
    { figure: 'Top Rated Seller', label: 'On Fiverr since 2015' },
    { figure: 'Pro Verified', label: 'On Fiverr since 2017' },
  ] },
  { kind: 'figure' as const, figure: '4.8k', label: 'Orders' },
  { kind: 'figure' as const, figure: '2.6k', label: 'Clients' },
  { kind: 'figure' as const, figure: '13', label: 'Years on Fiverr', dynamicYear: true },
  // Not clients: investors behind the owner's clients (owner, 2026-11-04). Logos from Brandfetch, files in public/clients;
  // Color copies only for chromatic artwork; identical sources keep hover geometry fixed (2026-11-04).
  { kind: 'logos' as const, label: 'Clients backed by', note: 'and other investors', logos: [
    { name: 'Citi', light: 'citi.svg', dark: 'citi.svg', height: 22, color: true },
    { name: 'Y Combinator', light: 'y-combinator.svg', dark: 'y-combinator.svg', height: 18, color: true },
    { name: 'Khosla Ventures', light: 'khosla-ventures.svg', dark: 'khosla-ventures-on-dark.png', height: 13 },
    { name: '500 Global', light: '500-global.svg', dark: '500-global-on-dark.svg', height: 18 },
    { name: 'Accel', light: 'accel.png', dark: 'accel-on-dark.svg', height: 24 },
    { name: 'Benchmark', light: 'benchmark.png', dark: 'benchmark-on-dark.png', height: 18 },
    { name: 'Bessemer Venture Partners', light: 'bessemer.svg', dark: 'bessemer.svg', height: 36, color: true },
    { name: 'Battery Ventures', light: 'battery.png', dark: 'battery-on-dark.svg', height: 22, color: true },
  ] },
  { kind: 'note' as const, text: 'Selected to give feedback to Fiverr leadership in Tel Aviv', label: 'In 2018' },
  { kind: 'quote' as const, testimonial: { quote: 'She gets it. You won’t get a pile of AI slop masquerading as copy.', name: 'Cannon Brooke', role: 'Founder', company: 'Brooke Solutions', photo: cannonBrooke } },
];
// The owner's Fiverr gigs (2026-11-03), titles as on Fiverr, in the "See my services" order. Review counts
// are ∞ until the owner has the numbers; 435 is from the Sales Copy card's screenshot.
// My approach: the owner's copy (2026-11-04); the Luddite row's last three sentences are Claude's draft from the owner's notes.
const approach = [
  { title: 'I like the complicated stuff', content: "I mostly write for B2B tech and products that need explaining. People aren’t buying your innovation but something that makes the pain go away, and I connect those dots." },
  { title: 'I build things, too', content: "I build AI workflows that automate boring, repeatable processes and run my own infrastructure. I understand both the marketing and the tech, which saves everyone some time." },
  { title: 'I challenge dodgy briefs', content: "Want a video sales letter? If the offer is the problem, a script won’t fix your sales. I’ll ask why you want to do things a certain way and flag any concerns before we start work." },
  { title: 'I tell you what I think', content: "I’m not in the business of massaging people’s egos when I can boost their bank accounts instead. I’m an experienced copywriter, not a desperate yes-man." },
  { title: 'You don’t have to chase me', content: "I send daily progress updates through the Fiverr inbox. I deliver on or ahead of schedule. If something goes wrong, I’ll tell you when there’s still time to fix it." },
  { title: 'I know what I don’t know', content: "Your team knows things about your business that I don’t. As an outsider, I want to hear from the builders as much as I do the marketers before I try to sell it." },
  { title: 'I judge success by outcomes', content: "Before we start work, we’ll agree on what success looks like. Once the project is live, I use those outcomes and any performance data to judge whether it worked." },
  { title: 'I’m an unapologetic Luddite', content: "I use AI every day, but I don’t outsource creativity or judgment. I divide the labor by what humans and machines do best to save time without cutting corners that lead to slop. The AI works behind the writing, on research, admin and the workflows around a project. If you want it nowhere near your project at all, just ask. That means switching off the workflows I’ve built, so the job will take longer and cost more." },
];
// Titles, categories and prices as listed on Fiverr (Second Brain business/emmaki/fiverr/gigs/); images where a gig has one.
const gigs = [
  { category: 'Sales Copy', title: 'I will write sales copy for landing pages, sales pages, and sales funnels', reviews: '435', price: 'From $150', image: salesCopyThumb },
  { category: 'Review & Rewrite', title: 'I will rewrite and improve articles, blogs, and website content', reviews: '∞', price: 'From $100' },
  { category: 'Press Releases', title: 'I will be your press release writing expert for PR and press release content creation', reviews: '∞', price: 'From $150' },
  { category: 'Blog Writing', title: 'I will write engaging SEO articles, do blog writing for targeted b2b and b2c marketing', reviews: '∞', price: 'From $150' },
  { category: 'Video Scripts', title: 'I will write a high converting video sales letters, VSL, and sales page video content', reviews: '∞', price: 'From $150' },
  { category: 'Website Content', title: 'I will be your seo website content writer for website copy and website copywriting', reviews: '∞', price: 'From $250' },
  { category: 'Email Copy', title: 'I will write your email marketing campaign, sales email copywriting, newsletter writing', reviews: '∞', price: 'From $125' },
  { category: 'AI Content Editing', title: 'I will turn AI slop into authentic thought leadership that converts', reviews: '∞', price: 'From $500' },
  { category: 'Ghostwriting', title: 'I will be your lead magnet writer, business ebook writer, non fiction ebook ghostwriter', reviews: '∞', price: 'From $125' },
  { category: 'Product Descriptions', title: 'I will optimize your fiverr gig SEO and gig description for mira', reviews: '∞', price: 'From $150', image: fiverrOptimisationThumb },
];
---
<Base>
  <link slot="head" rel="preload" as="image" href={portrait.src} type="image/webp" fetchpriority="high" />
  <HeroPoster>
    <Fragment slot="line">Does <em>anyone</em> actually get what you’re selling?</Fragment>
    <Fragment slot="support">You explain it to me once. I explain it to everyone else.</Fragment>
    <p slot="caption" class="poster-caption type-meta uppercase">Brands I’ve written for</p>
  </HeroPoster>
  <section>
    <ClientSlots class="shell" />
  </section>
  <CautionTape />
  <Statement kicker="Who I am" before="I write copy for B2B tech and other hard sells, so people" {links} after="." />
  <section class="shell pt-32">
    <div class="lg:flex lg:items-end lg:justify-between lg:gap-gutter">
      <div>
        <p class="type-meta text-fg-2 uppercase">Services</p>
        <h2 class="mt-6 max-w-[36ch] type-h2 text-fg-max">Get the brains without the payroll.</h2>
      </div>
      <p class="mt-6 max-w-[36ch] type-lead text-fg-2 text-pretty lg:mt-0">You shouldn't have to know how to solve a problem before hiring someone to solve it, let alone make every little decision for them.</p>
    </div>
    <div class="mt-12"><GigShelf {gigs} avatar={gigAvatar} seller="Emma R." badge="Vetted Pro" rating="5.0" extra="Offers video consultations" /></div>
  </section>
  <TestimonialGlobe reviews={globeReviews} />
  <div class="mt-32"><WhyMe kicker="Why me" heading="A convincing pitch takes minutes. A track record takes years." {credibility} /></div>
  <section class="shell pt-32">
    <p class="type-meta text-fg-2 uppercase">My approach</p>
    <h2 class="mt-6 max-w-[36ch] type-h2 text-fg-max">Copywriting is only part of my job.</h2>
    <div class="mt-12"><ApproachAccordion items={approach} /></div>
  </section>
  <section class="pt-32">
    <ClientSlots class="shell" />
  </section>
  <PageClosing />
</Base>
