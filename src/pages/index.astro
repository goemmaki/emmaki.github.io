---
import Base from '../layouts/Base.astro';
import ClientSlots from '../components/ClientSlots.astro';
import Statement from '../components/Statement.astro';
import WhyMe from '../components/WhyMe.astro';
import PageClosing from '../components/PageClosing.astro';
import HeroPoster from '../components/HeroPoster.astro';
import CautionTape from '../components/CautionTape.astro';
const links = [
  { text: 'A', href: '/proof', metric: '00%', summary: 'Placeholder: what changed for the client', client: 'Client one' },
  { text: 'B', href: '/proof', metric: '0 weeks', summary: 'Placeholder: what was written, and for what', client: 'Client two' },
  { text: 'C', href: '/proof', metric: '000+', summary: 'Placeholder: the result in one line', client: 'Client three' },
];
const credibility = [
  { kind: 'figure' as const, figure: 'Top Rated Seller', label: 'On Fiverr since 2015', accent: true },
  { kind: 'figure' as const, figure: '4.8k', label: 'Orders' },
  { kind: 'figure' as const, figure: '2.6k', label: 'Clients' },
  { kind: 'figure' as const, figure: '13', label: 'Years on Fiverr', dynamicYear: true },
  { kind: 'figure' as const, figure: 'Pro Verified', label: 'On Fiverr since 2017' },
  { kind: 'note' as const, text: 'Selected to give feedback to Fiverr leadership in Tel Aviv', label: 'In 2018' },
  { kind: 'quote' as const, testimonial: { quote: 'She gets it. You won’t get a pile of AI slop masquerading as copy.', name: 'Cannon Brooke', role: 'Founder', company: 'Brooke Solutions', photo: 'cannon-brooke.webp' } },
];
---
<Base>
  <link slot="head" rel="preload" as="image" href="/hero/portrait.png" fetchpriority="high" />
  <HeroPoster>
    <Fragment slot="line">Does <em>anyone</em> actually get what you’re selling?</Fragment>
    <Fragment slot="support">You explain it to me once. I explain it to everyone else.</Fragment>
    <p slot="caption" class="poster-caption type-meta uppercase">Brands I’ve written for</p>
  </HeroPoster>
  <section>
    <ClientSlots class="shell" />
  </section>
  <CautionTape />
  <Statement kicker="Who I am" before="I help X and Y to" {links} after=", without FGH." />
  <div class="mt-32"><WhyMe kicker="Why me" {credibility} /></div>
  <section class="shell pt-32"><p class="type-meta text-fg-2 uppercase">Why me</p><h2 class="mt-6 max-w-[26ch] type-h1 text-fg-max">Placeholder: why hire me, to be designed.</h2></section>
  <PageClosing />
</Base>
